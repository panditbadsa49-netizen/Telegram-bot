async def manage_admin(update: Update, context: ContextTypes.DEFAULT_TYPE, action: str) -> None:
    """এডমিন যুক্ত বা মুছে ফেলার জন্য সুপার এডমিন টুল।"""
    # শুধুমাত্র সুপার এডমিনই এই কাজটি করতে পারবে
    if update.effective_user.id != SUPER_ADMIN_CHAT_ID:
        return await update.message.reply_text("❌ শুধুমাত্র সুপার এডমিন এই কমান্ডটি ব্যবহার করতে পারেন।")

    if len(context.args) != 1:
        return await update.message.reply_text(f"ব্যবহারবিধি: `/{action}_admin <user_id>`")

    try:
        target_user_id = int(context.args[0])
        config_ref = db.collection("config").document("global_settings")
        
        current_admins = GLOBAL_CONFIG.get('admin_ids', [])
        
        if action == 'add':
            if target_user_id in current_admins:
                return await update.message.reply_text(f"⚠️ ইউজার ID `{target_user_id}` ইতিমধ্যেই এডমিন হিসেবে যুক্ত আছে।")
            
            current_admins.append(target_user_id)
            await update.message.reply_text(f"✅ ইউজার ID `{target_user_id}` সফলভাবে এডমিন হিসেবে যুক্ত হয়েছে।")

        elif action == 'delete':
            if target_user_id not in current_admins:
                return await update.message.reply_text(f"⚠️ ইউজার ID `{target_user_id}` এডমিন লিস্টে নেই।")
            
            if target_user_id == SUPER_ADMIN_CHAT_ID:
                return await update.message.reply_text("❌ সুপার এডমিনকে (নিজেকে) এডমিন লিস্ট থেকে মুছে ফেলা যাবে না।")
            
            current_admins.remove(target_user_id)
            await update.message.reply_text(f"✅ ইউজার ID `{target_user_id}` সফলভাবে এডমিন লিস্ট থেকে মুছে ফেলা হয়েছে।")
        
        # Firestore এবং গ্লোবাল কনফিগারেশন আপডেট করা
        loop = asyncio.get_event_loop()
        await loop.run_in_executor(None, config_ref.update, {'admin_ids': current_admins})
        GLOBAL_CONFIG['admin_ids'] = current_admins
        
    except Exception as e:
        await update.message.reply_text(f"ত্রুটি: ইউজার ID ঠিক নয়। ত্রুটি: {e}")

async def admin_list(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """বর্তমান এডমিনদের তালিকা দেখায়।"""
    if not is_admin(update.effective_user.id):
        return await update.message.reply_text("❌ আপনার এই কমান্ড ব্যবহারের অনুমতি নেই।")
        
    admin_ids = GLOBAL_CONFIG.get('admin_ids', [])
    
    admin_list_text = "✨ **বর্তমান এডমিন আইডি লিস্ট** ✨\n\n"
    for admin_id in admin_ids:
        # সুপার এডমিনকে চিহ্নিত করা
        marker = " (Super Admin)" if admin_id == SUPER_ADMIN_CHAT_ID else ""
        admin_list_text += f"`{admin_id}`{marker}\n"
        
    await update.message.reply_text(admin_list_text, parse_mode=ParseMode.MARKDOWN)


# =================================================================
# === ৮. প্রধান ফাংশন ও হ্যান্ডলার রেজিস্ট্রেশন ===
# =================================================================

def main() -> None:
    """বট চালানোর জন্য প্রধান ফাংশন।"""
    
    # ⚠️ ধাপ ১: Firestore ইনিশিয়ালাইজ করা এবং কনফিগারেশন লোড করা
    initialize_firestore()
    
    if db is False:
        logger.error("গুরুত্বপূর্ণ: Firestore সংযুক্ত না হওয়ায় বট বন্ধ হচ্ছে।")
        return
        
    application = Application.builder().token(TOKEN).build()
    
    # কনভারসেশন হ্যান্ডলার: কাজ জমা দিন (Work Submission)
    work_conv_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^✅ কাজ জমা দিন$'), start_work_submission)],
        states={
            WORK_SUBMISSION: [MessageHandler(filters.ALL, work_submission_handler)],
        },
        fallbacks=[MessageHandler(filters.Regex('^↩️ প্রধান মেনু$') | filters.COMMAND, withdraw_cancel)],
        allow_reentry=True
    )
    application.add_handler(work_conv_handler)
    
    # কনভারসেশন হ্যান্ডলার: উত্তোলন (Withdrawal)
    withdraw_conv_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^💵 উত্তোলন$'), start_withdraw)],
        states={
            WITHDRAW_STATE: [MessageHandler(filters.TEXT & ~filters.COMMAND, withdraw_amount)],
            WITHDRAW_AMOUNT: [CallbackQueryHandler(withdraw_method_callback, pattern='^withdraw_')],
            WITHDRAW_METHOD: [MessageHandler(filters.TEXT & ~filters.COMMAND, withdraw_submit)],
        },
        fallbacks=[MessageHandler(filters.Regex('^↩️ প্রধান মেনু$') | filters.COMMAND, withdraw_cancel)],
        allow_reentry=True
    )
    application.add_handler(withdraw_conv_handler)

    # সাধারণ কমান্ড ও মেসেজ হ্যান্ডলার
    application.add_handler(CommandHandler("start", start))
    application.add_handler(CallbackQueryHandler(button_callback))
    
    # এডমিন টুলস (ব্যালেন্স ও এডমিন ম্যানেজমেন্ট)
    application.add_handler(CommandHandler("add_balance", admin_add_balance))
    application.add_handler(CommandHandler("reduce_balance", admin_reduce_balance))
    application.add_handler(CommandHandler("set_referral_bonus", set_referral_bonus))
    application.add_handler(CommandHandler("add_admin", lambda u, c: manage_admin(u, c, 'add')))
    application.add_handler(CommandHandler("delete_admin", lambda u, c: manage_admin(u, c, 'delete')))
    application.add_handler(CommandHandler("admin_list", admin_list))
    
    # মিডিয়া (ছবি, স্ক্রীনশট, ভয়েস ইত্যাদি) ফরওয়ার্ডিং হ্যান্ডলার
    application.add_handler(MessageHandler(filters.PHOTO | filters.VOICE | filters.VIDEO | filters.DOCUMENT, handle_media_messages))
    
    # টেক্সট মেসেজ এবং রিপ্লাই কীবোর্ড হ্যান্ডলার (কমান্ড ছাড়া)
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text_buttons))

    # বট শুরু করা (পুলিং মোডে)
    logger.info("বট শুরু করা হচ্ছে...")
    application.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
