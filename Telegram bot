async def admin_add_balance(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """কাজ করে জমা যখন দিবে তাদের একাউন্টে যেন এডমিন ব্যালেন্স এড করে দিতে পারে।"""
    if not is_admin(update.effective_user.id):
        return await update.message.reply_text("❌ আপনার এই কমান্ড ব্যবহারের অনুমতি নেই।")

    if len(context.args) != 2:
        return await update.message.reply_text("ব্যবহারবিধি: `/add_balance <user_id> <amount>`")

    try:
        target_user_id = int(context.args[0])
        amount = float(context.args[1])
        
        user_data = await get_user_data(target_user_id)
        
        if user_data is None:
            return await update.message.reply_text("❌ ত্রুটি: ইউজার ডেটাবেসে পাওয়া যায়নি বা সংযোগে ত্রুটি হয়েছে।")

        # Firestore-এ ডেটা আপডেট (balance এবং total_earned বৃদ্ধি)
        await update_user_balance(target_user_id, {'balance': firestore.Increment(amount)}, increment_total_earned=amount)
        
        # নতুন ব্যালেন্স পেতে ডেটা আবার লোড করা
        updated_data = await get_user_data(target_user_id)
        new_balance = updated_data['balance']
        
        await update.message.reply_text(
            f"✅ **সফল!**\nইউজার ID: `{target_user_id}` অ্যাকাউন্টে **৳{amount:.2f}** যোগ করা হয়েছে।\nনতুন ব্যালেন্স: **৳{new_balance:.2f}**"
        )
        
        # ইউজারকে নোটিফিকেশন পাঠানো
        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text=f"🎉 **অভিনন্দন!** এডমিন আপনার কাজ অনুমোদন করেছেন।\nআপনার অ্যাকাউন্টে **৳{amount:.2f}** যোগ করা হয়েছে।\nবর্তমান ব্যালেন্স: **৳{new_balance:.2f}**",
                parse_mode=ParseMode.MARKDOWN
            )
        except Exception:
            pass 

    except Exception as e:
        await update.message.reply_text(f"ত্রুটি: কমান্ড ফরম্যাট ভুল বা ID/Amount ঠিক নয়। ত্রুটি: {e}")


