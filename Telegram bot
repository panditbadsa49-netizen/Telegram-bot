async def start_work_submission(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """কাজ জমা দেওয়ার প্রক্রিয়া শুরু করে।"""
    context.user_data['submission'] = {}
    await update.message.reply_text(
        "✅ **কাজ জমা দিন**\n\nপ্রথমে আপনার **স্ক্রীনশটটি** মেসেজ হিসেবে পাঠিয়ে দিন।",
        reply_markup=ReplyKeyboardRemove() # রিপ্লাই কীবোর্ড লুকানো
    )
    return WORK_SUBMISSION

async def work_submission_handler(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """কাজ জমা দেওয়ার মাল্টি-স্টেপ প্রসেস হ্যান্ডেল করে।"""
    submission_data = context.user_data.get('submission', {})
    message = update.message
    
    # ১. স্ক্রীনশট (Photo)
    if 'screenshot' not in submission_data and (message.photo or message.document):
        # ছবি বা ডকুমেন্ট গ্রহণ করা
        submission_data['screenshot_msg_id'] = message.message_id
        submission_data['chat_id'] = message.chat_id
        await message.reply_text("দারুণ! এবার আপনার **ইমেইল অ্যাড্রেসটি** টাইপ করে পাঠান।")
        context.user_data['submission'] = submission_data
        return WORK_SUBMISSION
        
    # ২. ইমেইল অ্যাড্রেস
    elif 'email' not in submission_data and message.text:
        submission_data['email'] = message.text.strip()
        await message.reply_text("ধন্যবাদ। এবার **রিভিউ নাম (Review Name)** টাইপ করে পাঠান।")
        context.user_data['submission'] = submission_data
        return WORK_SUBMISSION
        
    # ৩. রিভিউ নাম
    elif 'review_name' not in submission_data and message.text:
        submission_data['review_name'] = message.text.strip()
        await message.reply_text("প্রায় শেষ! এখন আপনার **ডিভাইস নাম (Device Name)** টাইপ করে পাঠান।")
        context.user_data['submission'] = submission_data
        return WORK_SUBMISSION

    # ৪. ডিভাইস নাম ও ফাইনাল সাবমিট
    elif 'device_name' not in submission_data and message.text:
        submission_data['device_name'] = message.text.strip()
        submission_data['user_id'] = message.from_user.id
        submission_data['timestamp'] = time.ctime()
        
        # এডমিনের জন্য ফাইনাল মেসেজ তৈরি
        final_message_for_admin = (
            f"🚨 **নতুন কাজের জমা (New Work Submission)** 🚨\n"
            f"👤 **ইউজার:** {message.from_user.full_name} (ID: `{submission_data['user_id']}`)\n"
            f"--- জমা দেওয়া তথ্য ---\n"
            f"📧 **ইমেইল:** {submission_data['email']}\n"
            f"🏷️ **রিভিউ নাম:** {submission_data['review_name']}\n"
            f"📱 **ডিভাইস:** {submission_data['device_name']}\n"
            f"⏰ **সময়:** {submission_data['timestamp']}\n"
            f"--- **অ্যাডমিন অ্যাকশন:** ---\n"
            f"এই কাজটি অনুমোদন করতে এই কমান্ডটি ব্যবহার করুন:\n"
            f"`/add_balance {submission_data['user_id']} <Amount>`"
        )
        
        # এডমিনের কাছে স্ক্রীনশট ফরওয়ার্ড করা
        await context.bot.forward_message(
            chat_id=ADMIN_CHAT_ID, 
            from_chat_id=submission_data['chat_id'], 
            message_id=submission_data['screenshot_msg_id']
        )
        
        # এডমিনের কাছে টেক্সট ডেটা পাঠানো
        await context.bot.send_message(
            chat_id=ADMIN_CHAT_ID,
            text=final_message_for_admin,
            parse_mode=ParseMode.MARKDOWN
        )

        # ইউজারকে ফাইনাল কনফার্মেশন ও এডমিনের সাথে যোগাযোগের নির্দেশ (এডমিন ইউজারনেম সহ)
        await message.reply_text(
            f"🎉 **আপনার কাজ সফলভাবে জমা হয়েছে!**\n\n"
            f"আপনার কাজ এডমিনের কাছে পাঠানো হয়েছে। এখন যদি আপনার কোনো অতিরিক্ত তথ্য দেওয়ার থাকে, তাহলে সরাসরি এডমিনের ইউজারনেম **@{ADMIN_USERNAME}** মেনশন করে এডমিনকে জানাতে পারেন অথবা অপেক্ষা করুন।\n\n"
            f"এডমিন: **@{ADMIN_USERNAME}**",
            reply_markup=REPLY_MARKUP # মেইন মেনু ফিরিয়ে আনা
        )
        
        return ConversationHandler.END

    else:
        await message.reply_text("দুঃখিত, আমি আপনার স্ক্রীনশট বা মেসেজ বুঝতে পারিনি। প্রথমে **স্ক্রীনশট/ছবি** পাঠান, অথবা যদি ভুল করে এখানে এসে থাকেন তবে '↩️ প্রধান মেনু' বাটনে ক্লিক করুন।")
        return WORK_SUBMISSION


