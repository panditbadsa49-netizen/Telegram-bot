def is_admin(user_id: int) -> bool:
    """চেক করে ইউজার এডমিন কিনা।"""
    # config লোড না হলে, শুধুমাত্র সুপার এডমিনকে অনুমতি দেওয়া
    if not GLOBAL_CONFIG:
        return user_id == SUPER_ADMIN_CHAT_ID
        
    return user_id in GLOBAL_CONFIG.get('admin_ids', [])

async def get_user_data(user_id: int):
    """Firestore থেকে ইউজারের ডেটা নিয়ে আসে বা নতুন ইউজার তৈরি করে।"""
    if db is False:
        return None
        
    user_ref = db.collection("users").document(str(user_id))
    
    loop = asyncio.get_event_loop()
    doc = await loop.run_in_executor(None, user_ref.get)
    
    if doc.exists:
        data = doc.to_dict()
        data['balance'] = float(data.get('balance', 0.00))
        data['total_earned'] = float(data.get('total_earned', 0.00))
        data['referral_count'] = int(data.get('referral_count', 0))
        return data
    else:
        initial_data = {
            'full_name': None, 
            'balance': 0.00, 
            'total_earned': 0.00,
            'referred_by': None,
            'referral_count': 0
        }
        await loop.run_in_executor(None, user_ref.set, initial_data)
        logger.info(f"🆕 নতুন ইউজার তৈরি হলো: {user_id}")
        return initial_data

async def update_user_balance(user_id: int, new_data: dict, increment_total_earned: float = 0):
    """Firestore-এ ইউজারের ডেটা আপডেট করে।"""
    if db is False:
        return 
        
    user_ref = db.collection("users").document(str(user_id))
    
    # firestore.Increment ব্যবহার করতে হলে, একটি নতুন dict তৈরি করতে হবে
    update_dict = {k: v for k, v in new_data.items() if k in ['balance', 'full_name', 'referred_by']}
    
    if increment_total_earned != 0:
         update_dict['total_earned'] = firestore.Increment(increment_total_earned)

    if 'referral_count' in new_data:
        update_dict['referral_count'] = firestore.Increment(new_data['referral_count'])

    # অ্যাসিঙ্ক্রোনাসভাবে আপডেট করা
    loop = asyncio.get_event_loop()
    await loop.run_in_executor(None, user_ref.update, update_dict)
    logger.info(f"✅ ইউজার {user_id} এর ডেটা আপডেট হয়েছে।")


