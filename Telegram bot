def get_user_data(user_id):
    """ইউজারের ব্যালেন্স সহ সকল ডাটা রিটার্ন করে। নতুন ইউজার হলে ডাটা ইনিশিয়ালাইজ করে।"""
    if user_id not in user_data_db:
        # নতুন ইউজারের জন্য ইনিশিয়ালাইজ
        user_data_db[user_id] = {
            'full_name': None, 
            'balance': 0.00, 
            'total_earned': 0.00,
            'referred_by': None,
            'referral_count': 0
        }
    return user_data_db[user_id]

