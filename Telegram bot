async def get_config_data():
    """Firestore থেকে গ্লোবাল কনফিগারেশন (যেমন রেফারেল বোনাস, এডমিন লিস্ট) লোড করে বা সেট করে।"""
    global GLOBAL_CONFIG
    
    config_ref = db.collection("config").document("global_settings")
    loop = asyncio.get_event_loop()
    
    # কনফিগারেশন লোড করা
    doc = await loop.run_in_executor(None, config_ref.get)
    
    if doc.exists:
        data = doc.to_dict()
        GLOBAL_CONFIG['referral_bonus'] = float(data.get('referral_bonus', 0.50)) # ডিফল্ট 0.50
        
        # নিশ্চিত করা যে সুপার এডমিন সবসময় লিস্টে আছে
        admin_ids = data.get('admin_ids', [])
        if SUPER_ADMIN_CHAT_ID not in admin_ids:
            admin_ids.append(SUPER_ADMIN_CHAT_ID)
            # Firestore-এ আপডেট করা
            await loop.run_in_executor(None, config_ref.update, {'admin_ids': admin_ids})
            
        GLOBAL_CONFIG['admin_ids'] = admin_ids
        logger.info(f"✅ Config লোড হয়েছে। রেফারেল বোনাস: {GLOBAL_CONFIG['referral_bonus']}.")
    else:
        # config ডকুমেন্ট না থাকলে, ডিফল্ট ডেটা সেট করা
        default_config = {
            'referral_bonus': 0.50,
            'admin_ids': [SUPER_ADMIN_CHAT_ID],
        }
        await loop.run_in_executor(None, config_ref.set, default_config)
        GLOBAL_CONFIG = default_config
        logger.warning("⚠️ Config ডকুমেন্ট তৈরি করা হয়েছে।")

def initialize_firestore():
    """Firestore SDK ইনিশিয়ালাইজ করে এবং কনফিগারেশন লোড করে।"""
    global db
    if db is None:
        try:
            # JSON স্ট্রিং থেকে ক্রেডেনশিয়াল লোড করা
            cred_dict = json.loads(FIREBASE_CREDENTIALS_JSON)
            
            if cred_dict.get('private_key_id') and cred_dict.get('project_id'):
                cred = credentials.Certificate(cred_dict)
                firebase_admin.initialize_app(cred)
                
                db = firestore.client()
                logger.info("✅ Firestore Database সফলভাবে সংযুক্ত হয়েছে।")
                
                # কনফিগারেশন লোড করা (Sync/Async হ্যান্ডলিং)
                try:
                    asyncio.run(get_config_data())
                except RuntimeError:
                    # যদি main() একটি রানিং ইভেন্ট লুপের ভিতরে থাকে
                    loop = asyncio.get_event_loop()
                    loop.run_until_complete(get_config_data())
            else:
                 logger.error("❌ Firestore সংযোগে ত্রুটি: FIREBASE_CREDENTIALS_JSON-এ কোনো ডেটা পাওয়া যায়নি।")
                 db = False
        except Exception as e:
            logger.error(f"❌ Firestore সংযোগে ত্রুটি: {e}")
            db = False 

