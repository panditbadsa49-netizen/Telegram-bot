async def admin_add_balance(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """৫. কাজ করে জমা যখন দিবে তাদের একাউন্টে যেন এডমিন ব্যালেন্স এড করে দিতে পারে।"""
    if update.effective_user.id != ADMIN_CHAT_ID:
        return # শুধুমাত্র এডমিনের জন্য

    if len(context.args) != 2:
        await update.message.reply_text("ব্যবহারবিধি: `/add_balance <user_id> <amount>`")
        return

    try:
        target_user_id = int(context.args[0])
        amount = float(context.args[1])
        
        user_data = get_user_data(target_user_id)
        
        # ৬. ইনকাম ক্যালকুলেশন
        user_data['balance'] += amount
        user_data['total_earned'] += amount
        
        await update.message.reply_text(
            f"✅ **সফল!**\nইউজার ID: `{target_user_id}` অ্যাকাউন্টে **৳{amount:.2f}** যোগ করা হয়েছে।\nনতুন ব্যালেন্স: **৳{user_data['balance']:.2f}**"
        )
        
        # ইউজারকে নোটিফিকেশন পাঠানো
        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text=f"🎉 **অভিনন্দন!** এডমিন আপনার কাজ অনুমোদন করেছেন।\nআপনার অ্যাকাউন্টে **৳{amount:.2f}** যোগ করা হয়েছে।\nবর্তমান ব্যালেন্স: **৳{user_data['balance']:.2f}**"
            )
        except Exception:
            pass # যদি ইউজার বট ব্লক করে থাকে

    except Exception as e:
        await update.message.reply_text(f"ত্রুটি: কমান্ড ফরম্যাট ভুল বা ID/Amount ঠিক নয়। ত্রুটি: {e}")


async def admin_reduce_balance(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """উত্তোলনের পর ব্যালেন্স কমানোর জন্য এডমিন টুল।"""
    if update.effective_user.id != ADMIN_CHAT_ID:
        return # শুধুমাত্র এডমিনের জন্য

    if len(context.args) != 2:
        await update.message.reply_text("ব্যবহারবিধি: `/reduce_balance <user_id> <amount>`")
        return

    try:
        target_user_id = int(context.args[0])
        amount = float(context.args[1])
        
        user_data = get_user_data(target_user_id)
        
        if user_data['balance'] < amount:
            await update.message.reply_text("⚠️ **সতর্কতা:** ইউজারের ব্যালেন্সের চেয়ে বেশি কমানো সম্ভব নয়।")
            return

        user_data['balance'] -= amount
        
        await update.message.reply_text(
            f"✅ **সফল!**\nইউজার ID: `{target_user_id}` অ্যাকাউন্ট থেকে **৳{amount:.2f}** (উত্তোলনের জন্য) বিয়োগ করা হয়েছে।\nনতুন ব্যালেন্স: **৳{user_data['balance']:.2f}**"
        )
        
        # ইউজারকে নোটিফিকেশন পাঠানো
        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text=f"💸 **আপনার পেমেন্ট সফল হয়েছে!**\nআপনার উত্তোলনকৃত **৳{amount:.2f}** আপনার নির্বাচিত মাধ্যমে পাঠানো হয়েছে।\nবর্তমান ব্যালেন্স: **৳{user_data['balance']:.2f}**"
            )
        except Exception:
            pass

    except Exception as e:
        await update.message.reply_text(f"ত্রুটি: কমান্ড ফরম্যাট ভুল বা ID/Amount ঠিক নয়। ত্রুটি: {e}")


# =================================================================
# === ১১. প্রধান ফাংশন ও হ্যান্ডলার রেজিস্ট্রেশন ===
# =================================================================

def main() -> None:
    """বট চালানোর জন্য প্রধান ফাংশন।"""
    application = Application.builder().token(TOKEN).build()
    
    # কনভারসেশন হ্যান্ডলার: কাজ জমা দিন (Work Submission)
    work_conv_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^✅ কাজ জমা দিন$'), start_work_submission)],
        states={
            WORK_SUBMISSION: [MessageHandler(filters.ALL, work_submission_handler)],
        },
        fallbacks=[MessageHandler(filters.Regex('^↩️ প্রধান মেনু$'), withdraw_cancel)],
        allow_reentry=True
    )
    application.add_handler(work_conv_handler)
    
    # কনভারসেশন হ্যান্ডলার: উত্তোলন (Withdrawal)
    withdraw_conv_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^💵 উত্তোলন$'), start_withdraw)],
        states={
            WITHDRAW_STATE: [MessageHandler(filters.TEXT & ~filters.COMMAND, withdraw_amount)],
            WITHDRAW_AMOUNT: [CallbackQueryHandler(withdraw_method_callback, pattern='^withdraw_')],
            WITHDRAW_METHOD: [MessageHandler(filters.TEXT & ~filters.COMMAND, withdraw_submit)],
        },
        fallbacks=[MessageHandler(filters.Regex('^↩️ প্রধান মেনু$'), withdraw_cancel), CommandHandler('cancel', withdraw_cancel)],
        allow_reentry=True
    )
    application.add_handler(withdraw_conv_handler)

    # সাধারণ কমান্ড ও মেসেজ হ্যান্ডলার
    application.add_handler(CommandHandler("start", start))
    application.add_handler(CallbackQueryHandler(button_callback))
    
    # এডমিন টুলস (ব্যালেন্স ম্যানেজমেন্ট)
    application.add_handler(CommandHandler("add_balance", admin_add_balance))
    application.add_handler(CommandHandler("reduce_balance", admin_reduce_balance))
    
    # ২. মিডিয়া (ছবি, স্ক্রীনশট, ভয়েস ইত্যাদি) ফরওয়ার্ডিং হ্যান্ডলার
    application.add_handler(MessageHandler(filters.PHOTO | filters.VOICE | filters.VIDEO | filters.DOCUMENT, handle_media_messages))
    
    # ২. টেক্সট মেসেজ এবং রিপ্লাই কীবোর্ড হ্যান্ডলার (কমান্ড ছাড়া)
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text_buttons))

    # বট শুরু করা (পুলিং মোডে)
    logger.info("বট শুরু করা হচ্ছে...")
    application.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
