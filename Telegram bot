async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """/start কমান্ড হ্যান্ডেল করে এবং প্রথমবার ইউজারকে ইসলামিক সালাম দেয়।"""
    user = update.effective_user
    user_id = user.id
    is_new_user = user_id not in user_data_db
    
    # ডাটা ইনিশিয়ালাইজ/সংগ্রহ
    user_data = get_user_data(user_id)
    if user_data['full_name'] is None:
        user_data['full_name'] = user.full_name
        
    # রেফেলার ট্র্যাকিং
    if context.args and is_new_user:
        try:
            referrer_id = int(context.args[0].replace('ref_', ''))
            if referrer_id != user_id and referrer_id in user_data_db:
                user_data['referred_by'] = referrer_id
                referrer_data = get_user_data(referrer_id)
                referrer_data['referral_count'] += 1
                referrer_data['balance'] += REFERRAL_BONUS
                
                await context.bot.send_message(
                    chat_id=referrer_id,
                    text=f"🎉 **অভিনন্দন!**\nআপনার রেফারেল লিংক ব্যবহার করে **{user.full_name}** বটটি ব্যবহার শুরু করেছেন।\nআপনার অ্যাকাউন্টে **৳{REFERRAL_BONUS:.2f}** যোগ করা হয়েছে।\nবর্তমান ব্যালেন্স: **৳{referrer_data['balance']:.2f}**"
                )
                logger.info(f"User {user_id} referred by {referrer_id}. Balance updated.")
        except Exception as e:
            logger.error(f"Referral parsing error: {e}")
            
    # ৪. প্রথমবার ইউজারকে ইসলামিক সালাম
    greeting_message = (
        f"﷽\n\n"
        f"প্রিয় {user.full_name}، **আসসালামু আলাইকুম ওয়া রাহমাতুল্লাহি ওয়া বারাকাতুহ!**\n\n"
        f"আমাদের বটটিতে স্বাগতম। আপনি নিচে দেওয়া অপশনগুলো ব্যবহার করে সহজেই কাজ শুরু করতে পারেন।"
    )
    
    await update.message.reply_text(greeting_message, reply_markup=REPLY_MARKUP, parse_mode=ParseMode.MARKDOWN)
    
    # যদি ইউজার /start কমান্ড দেয়, তবে main_menu-এর বাটনগুলোও দেখাবে।
    await handle_dynamic_menu(update, context, 'main_menu')
    
    return ConversationHandler.END


async def handle_dynamic_menu(update: Update, context: ContextTypes.DEFAULT_TYPE, menu_id: str) -> None:
    """ডাইনামিক মেনু এবং কন্টেন্ট প্রদর্শন করে।"""
    menu_item = MENU_DATA.get(menu_id)
    if not menu_item:
        return
        
    message_text = menu_item.get('message', 'কোনো বার্তা সেট করা হয়নি।')
    
    keyboard = []
    for row in menu_item.get('buttons', []):
        row_buttons = []
        for btn in row:
            if 'url' in btn:
                row_buttons.append(InlineKeyboardButton(btn['text'], url=btn['url']))
            elif 'data' in btn:
                row_buttons.append(InlineKeyboardButton(btn['text'], callback_data=btn['data']))
        if row_buttons:
            keyboard.append(row_buttons)
            
    inline_markup = InlineKeyboardMarkup(keyboard)

    # 1. সকল অপশন এডমিন edit করতে যেন পারে (নতুন মেসেজ পাঠানো হচ্ছে)
    if update.callback_query:
        await update.callback_query.message.reply_text(
            text=message_text,
            reply_markup=inline_markup,
            parse_mode=ParseMode.MARKDOWN 
        )
    else:
        await update.message.reply_text(
            text=message_text,
            reply_markup=inline_markup,
            parse_mode=ParseMode.MARKDOWN
        )

