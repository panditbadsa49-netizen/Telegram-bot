async def start_withdraw(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """উত্তোলন প্রক্রিয়া শুরু করে।"""
    user_data = get_user_data(update.effective_user.id)
    # মিনিমাম উইথড্র লিমিট (উদাহরণস্বরূপ ১০ টাকা)
    MIN_WITHDRAW = 10.00
    if user_data['balance'] < MIN_WITHDRAW: 
        await update.message.reply_text("💵 **উত্তোলন সম্ভব নয়!**\n\nউত্তোলন করতে আপনার সর্বনিম্ন **৳{:.2f}** ব্যালেন্স প্রয়োজন। আপনার বর্তমান ব্যালেন্স: **৳{:.2f}**।".format(MIN_WITHDRAW, user_data['balance']))
        return ConversationHandler.END
        
    context.user_data['withdraw'] = {}
    await update.message.reply_text(
        "💵 **উত্তোলন ফর্ম**\n\nআপনি কত টাকা উত্তোলন করতে চান? (যেমন: ৫০ বা ১০০)",
        reply_markup=ReplyKeyboardRemove()
    )
    return WITHDRAW_STATE

async def withdraw_amount(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """উত্তোলনের পরিমাণ যাচাই করে।"""
    try:
        amount = float(update.message.text.strip())
        user_data = get_user_data(update.effective_user.id)
        
        if amount > user_data['balance']:
            await update.message.reply_text("আপনার ব্যালেন্সের চেয়ে বেশি টাকা উত্তোলন করা যাবে না। আপনার বর্তমান ব্যালেন্স: **৳{:.2f}**। সঠিক পরিমাণ দিন।".format(user_data['balance']))
            return WITHDRAW_STATE
        
        if amount <= 0:
            await update.message.reply_text("উত্তোলনের পরিমাণ শূন্য বা নেতিবাচক হতে পারে না। সঠিক পরিমাণ দিন।")
            return WITHDRAW_STATE

        context.user_data['withdraw']['amount'] = amount
        
        # উত্তোলনের মাধ্যম নির্বাচন
        keyboard = [[InlineKeyboardButton(opt, callback_data=f"withdraw_{opt}")] for opt in WITHDRAWAL_OPTIONS]
        await update.message.reply_text(
            f"আপনি **৳{amount:.2f}** উত্তোলন করতে চান। এখন উত্তোলনের মাধ্যমটি নির্বাচন করুন:",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )
        return WITHDRAW_AMOUNT

    except ValueError:
        await update.message.reply_text("অনুগ্রহ করে শুধুমাত্র সংখ্যায় টাকার পরিমাণ দিন।")
        return WITHDRAW_STATE

async def withdraw_method_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """উত্তোলনের মাধ্যম নির্বাচন হ্যান্ডেল করে।"""
    query = update.callback_query
    await query.answer()
    
    method = query.data.split('_')[1]
