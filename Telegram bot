async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """/start কমান্ড হ্যান্ডেল করে এবং Firestore থেকে ডেটা লোড/সেভ করে।"""
    user = update.effective_user
    user_id = user.id
    
    user_data = await get_user_data(user_id)
    if user_data is None:
        await update.message.reply_text("❌ দুঃখিত! ডাটাবেস সংযোগে গুরুতর ত্রুটি হয়েছে। এডমিনের সাথে যোগাযোগ করুন।", reply_markup=ReplyKeyboardRemove())
        return ConversationHandler.END

    is_new_user = user_data.get('full_name') is None
    
    if is_new_user:
        user_data['full_name'] = user.full_name
        # নতুন ইউজার হলে ফায়ারবেসে পুরো নাম সেভ করা
        await update_user_balance(user_id, {'full_name': user.full_name})
        
    # রেফেলার ট্র্যাকিং
    referral_bonus = GLOBAL_CONFIG.get('referral_bonus', 0.50)
    
    if context.args and is_new_user:
        try:
            # ref_123456
            referrer_id = int(context.args[0].replace('ref_', ''))
            if referrer_id != user_id:
                referrer_data = await get_user_data(referrer_id)
                if referrer_data:
                    # ইউজার ডেটা আপডেট
                    await update_user_balance(user_id, {'referred_by': referrer_id})

                    # রেফেলার ডেটা আপডেট
                    await update_user_balance(referrer_id, {'balance': firestore.Increment(referral_bonus), 'referral_count': 1}, increment_total_earned=referral_bonus)
                    new_referrer_balance = referrer_data['balance'] + referral_bonus

                    await context.bot.send_message(
                        chat_id=referrer_id,
                        text=f"🎉 **অভিনন্দন!**\nআপনার রেফারেল লিংক ব্যবহার করে **{user.full_name}** বটটি ব্যবহার শুরু করেছেন।\nআপনার অ্যাকাউন্টে **৳{referral_bonus:.2f}** যোগ করা হয়েছে।\nবর্তমান ব্যালেন্স: **৳{new_referrer_balance:.2f}**",
                        parse_mode=ParseMode.MARKDOWN
                    )
                    logger.info(f"User {user_id} referred by {referrer_id}. Balance updated.")
        except Exception as e:
            logger.error(f"Referral processing error: {e}")
            
    # প্রথমবার ইউজারকে ইসলামিক সালাম
    greeting_message = (
        f"﷽\n\n"
        f"প্রিয় {user.full_name}، **আসসালামু আলাইকুম ওয়া রাহমাতুল্লাহি ওয়া বারাকাতুহ!**\n\n"
        f"আমাদের বটটিতে স্বাগতম। নিচের অপশনগুলো ব্যবহার করে সহজেই কাজ শুরু করতে পারেন।"
    )
    
    # রিপ্লাই কীবোর্ড যুক্ত করা
    await update.message.reply_text(greeting_message, reply_markup=REPLY_MARKUP, parse_mode=ParseMode.MARKDOWN)
    
    # মেইন মেনু ডিসপ্লে করা
    await handle_dynamic_menu(update, context, 'main_menu')
    
    return ConversationHandler.END


async def handle_dynamic_menu(update: Update, context: ContextTypes.DEFAULT_TYPE, menu_id: str) -> None:
    """ডাইনামিক মেনু এবং কন্টেন্ট প্রদর্শন করে।"""
    menu_item = MENU_DATA.get(menu_id)
    if not menu_item:
        return
        
    message_text = menu_item.get('message', 'কোনো বার্তা সেট করা হয়নি।')
    
    keyboard = []
    for row in menu_item.get('buttons', []):
        row_buttons = []
        for btn in row:
            if 'url' in btn:
                row_buttons.append(InlineKeyboardButton(btn['text'], url=btn['url']))
            elif 'data' in btn:
                row_buttons.append(InlineKeyboardButton(btn['text'], callback_data=btn['data']))
        if row_buttons:
            keyboard.append(row_buttons)
            
    inline_markup = InlineKeyboardMarkup(keyboard)

    if update.callback_query:
        # Callback query-এর ক্ষেত্রে পূর্বের মেসেজ এডিট করার চেষ্টা করা (Reply Keyboard থাকবে)
        try:
            await update.callback_query.edit_message_text(
                text=message_text,
                reply_markup=inline_markup,
                parse_mode=ParseMode.MARKDOWN 
            )
        except Exception:
            # যদি এডিট করা না যায় (যেমন মেসেজ অনেক পুরনো), তখন নতুন মেসেজ পাঠানো (Reply Keyboard থাকবে)
