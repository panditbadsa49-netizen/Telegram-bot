        user_data = await get_user_data(update.effective_user.id)
        if amount > user_data.get('balance', 0):
            await update.message.reply_text("⚠️ অপর্যাপ্ত ব্যালেন্স। সঠিক পরিমাণ লিখুন:")
            return WITHDRAW_AMOUNT
        if amount < 10:
            await update.message.reply_text("⚠️ সর্বনিম্ন উত্তোলন ৳১০। সঠিক পরিমাণ লিখুন:")
            return WITHDRAW_AMOUNT
            
        context.user_data['w_amount'] = amount
        await update.message.reply_text("পেমেন্ট মেথড লিখুন (বিকাশ/নগদ/রকেট/বাইনান্স):")
        return WITHDRAW_METHOD
    except:
        await update.message.reply_text("❌ ভুল ইনপুট। দয়া করে ইংরেজি সংখ্যা ব্যবহার করুন।")
        return WITHDRAW_AMOUNT

async def receive_withdraw_method(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data['w_method'] = update.message.text
    await update.message.reply_text("আপনার নম্বর/আইডি দিন:")
    return WITHDRAW_NUMBER

async def receive_withdraw_number(update: Update, context: ContextTypes.DEFAULT_TYPE):
    number = update.message.text
    user = update.effective_user
    amount = context.user_data['w_amount']
    method = context.user_data['w_method']
    
    msg = (
        f"💸 **উত্তোলন অনুরোধ!**\n"
        f"ইউজার: {user.full_name} (`{user.id}`)\n"
        f"পরিমাণ: ৳{amount}\n"
        f"মাধ্যম: {method}\n"
        f"নম্বর: `{number}`\n\n"
        f"⚠️ টাকা পাঠিয়ে ব্যালেন্স কাটতে: `/reduce_balance {user.id} {amount}`"
    )
    
    await context.bot.send_message(chat_id=SUPER_ADMIN_CHAT_ID, text=msg, parse_mode=ParseMode.MARKDOWN)
    await update.message.reply_text("✅ রিকোয়েস্ট এডমিনের কাছে পাঠানো হয়েছে।", reply_markup=REPLY_KEYBOARD)
    context.user_data.clear()
    return ConversationHandler.END

async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("⛔ বাতিল করা হলো।", reply_markup=REPLY_KEYBOARD)
    context.user_data.clear()
    return ConversationHandler.END

