async def post_init(app):
    """বট চালুর পর কনফিগ লোড করে।"""
    await load_config()

def main():
    # ফায়ারবেস কানেকশন
    initialize_firestore()
    
    if db is False:
        print("❌ বট বন্ধ হচ্ছে কারণ ডাটাবেস কানেক্ট হয়নি।")
        return

    app = ApplicationBuilder().token(TOKEN).post_init(post_init).build()

    # কমান্ড হ্যান্ডলার
    app.add_handler(CommandHandler("start", start))
    
    # মেনু বাটন (টেক্সট মেসেজ হ্যান্ডলিং - রিপ্লাই কীবোর্ড)
    # এটি ইনলাইন মেনু দেখাবে যখন ইউজার নিচের বাটনগুলো চাপবে
    app.add_handler(MessageHandler(filters.Regex('^🔴 Review Generator$'), lambda u,c: u.message.reply_text("দয়া করে লিংকে ক্লিক করুন:", reply_markup=get_inline_keyboard('main_menu'))))
    app.add_handler(MessageHandler(filters.Regex('^📜 তথ্য দেখুন$'), lambda u,c: u.message.reply_text("তথ্য মেনু:", reply_markup=get_inline_keyboard('info_menu'))))
    app.add_handler(MessageHandler(filters.Regex('^💼 কাজ দেখুন$'), lambda u,c: u.message.reply_text("কাজ মেনু:", reply_markup=get_inline_keyboard('work_menu'))))
    
    # কনভারসেশন হ্যান্ডলার (কাজ ও উত্তোলন)
    work_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^✅ কাজ জমা দিন$'), start_work)],
        states={
            WORK_PHOTO: [MessageHandler(filters.PHOTO, receive_work_photo)],
            WORK_DETAILS: [MessageHandler(filters.TEXT, receive_work_details)]
        },
        fallbacks=[CommandHandler('cancel', cancel), MessageHandler(filters.Regex('^ বাতিল$'), cancel)]
    )
    
    withdraw_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^💵 উত্তোলন$'), start_withdraw)],
        states={
            WITHDRAW_AMOUNT: [MessageHandler(filters.TEXT, receive_withdraw_amount)],
            WITHDRAW_METHOD: [MessageHandler(filters.TEXT, receive_withdraw_method)],
            WITHDRAW_NUMBER: [MessageHandler(filters.TEXT, receive_withdraw_number)]
        },
        fallbacks=[CommandHandler('cancel', cancel), MessageHandler(filters.Regex('^ বাতিল$'), cancel)]
    )
    
    app.add_handler(work_handler)
    app.add_handler(withdraw_handler)
    
    # ইনলাইন বাটন হ্যান্ডলার
    app.add_handler(CallbackQueryHandler(handle_menu_callback))
    
    # এডমিন কমান্ড হ্যান্ডলার
    app.add_handler(CommandHandler(['admin_list', 'set_referral_bonus', 'add_balance', 'reduce_balance', 'add_admin', 'delete_admin'], admin_cmd_handler))
    
    # ফরওয়ার্ডিং (যদি ইউজার কোনো টেক্সট বা মিডিয়া পাঠায় এবং কোনো স্টেটে না থাকে)
    # সাধারণ মেসেজ সুপার এডমিনের কাছে ফরওয়ার্ড হবে
    async def forward_msg(update, context):
        if update.message.chat_id != SUPER_ADMIN_CHAT_ID:
            await update.message.forward(SUPER_ADMIN_CHAT_ID)
            await update.message.reply_text("আপনার মেসেজ এডমিনের কাছে পাঠানো হয়েছে।")
            
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND & ~filters.Regex('^(💵|✅|📜|💼|🔴)'), forward_msg))
    app.add_handler(MessageHandler(filters.PHOTO | filters.VIDEO | filters.VOICE, forward_msg))

    print("✅ বট সফলভাবে চালু হয়েছে...")
    app.run_polling()

if __name__ == "__main__":
    main()
