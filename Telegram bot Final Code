def initialize_firestore():
    """Firestore কানেকশন তৈরি করে।"""
    global db
    if db is None:
        try:
            # JSON স্ট্রিং লোড করা
            cred_dict = json.loads(FIREBASE_CREDENTIALS_JSON)
            
            # চেক করা হচ্ছে ক্রেডেনশিয়াল আসল কিনা (Project ID ফিল্ড আছে কিনা)
            if 'project_id' in cred_dict and 'PROJECT_ID' not in cred_dict['project_id']:
                cred = credentials.Certificate(cred_dict)
                if not firebase_admin._apps:
                    firebase_admin.initialize_app(cred)
                db = firestore.client()
                logger.info("✅ Firestore সফলভাবে সংযুক্ত হয়েছে।")
            else:
                logger.error("❌ ত্রুটি: আপনি এখনো JSON ক্রেডেনশিয়াল পেস্ট করেননি! ডিফল্ট ভ্যালু রয়ে গেছে।")
                db = False
        except Exception as e:
            logger.error(f"❌ Firestore সংযোগে ত্রুটি: {e}")
            db = False 

async def load_config():
    """ডাটাবেস থেকে এডমিন লিস্ট এবং বোনাস লোড করে।"""
    global GLOBAL_CONFIG
    if db:
        try:
            # ব্লকিং কল এড়াতে run_in_executor ব্যবহার করা
            loop = asyncio.get_running_loop()
            doc_ref = db.collection('config').document('global_settings')
            doc = await loop.run_in_executor(None, doc_ref.get)
            
            if doc.exists:
                data = doc.to_dict()
                GLOBAL_CONFIG['referral_bonus'] = float(data.get('referral_bonus', 0.50))
                saved_admins = data.get('admin_ids', [])
                
                # সুপার এডমিনকে নিশ্চিতভাবে যুক্ত রাখা
                if SUPER_ADMIN_CHAT_ID not in saved_admins:
                    saved_admins.append(SUPER_ADMIN_CHAT_ID)
                    await loop.run_in_executor(None, lambda: doc_ref.set({'admin_ids': saved_admins}, merge=True))
                
                GLOBAL_CONFIG['admin_ids'] = saved_admins
                logger.info(f"📥 কনফিগারেশন লোড হয়েছে: বোনাস={GLOBAL_CONFIG['referral_bonus']}, এডমিন={len(GLOBAL_CONFIG['admin_ids'])} জন")
            else:
                # প্রথমবার কনফিগ তৈরি করা
                initial_config = {'referral_bonus': 0.50, 'admin_ids': [SUPER_ADMIN_CHAT_ID]}
                await loop.run_in_executor(None, lambda: doc_ref.set(initial_config))
                GLOBAL_CONFIG = initial_config
                logger.info("🆕 নতুন কনফিগারেশন তৈরি করা হয়েছে।")
        except Exception as e:
            logger.error(f"⚠️ কনফিগারেশন লোড করতে ব্যর্থ: {e}")

