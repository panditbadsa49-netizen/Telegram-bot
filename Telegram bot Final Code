async def admin_cmd_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """সকল এডমিন কমান্ড হ্যান্ডেল করে।"""
    user_id = update.effective_user.id
    command = update.message.text.split()[0]
    
    # এডমিন পারমিশন চেক
    if not is_admin(user_id):
        return 
        
    try:
        # --- এডমিন লিস্ট ---
        if command == '/admin_list':
            admins = GLOBAL_CONFIG.get('admin_ids', [])
            txt = "👑 **এডমিন লিস্ট:**\n"
            for aid in admins:
                role = " (SUPER)" if aid == SUPER_ADMIN_CHAT_ID else ""
                txt += f"- `{aid}`{role}\n"
            await update.message.reply_text(txt, parse_mode=ParseMode.MARKDOWN)
            
        # --- বোনাস সেট করা ---
        elif command == '/set_referral_bonus':
            if not context.args:
                curr = GLOBAL_CONFIG.get('referral_bonus', 0.50)
                await update.message.reply_text(f"বর্তমান বোনাস: ৳{curr:.2f}")
                return
            amount = float(context.args[0])
            
            # DB আপডেট (async executor দিয়ে)
            loop = asyncio.get_running_loop()
            ref = db.collection('config').document('global_settings')
            await loop.run_in_executor(None, lambda: ref.set({'referral_bonus': amount}, merge=True))
            
            GLOBAL_CONFIG['referral_bonus'] = amount
            await update.message.reply_text(f"✅ রেফারেল বোনাস সেট করা হয়েছে: ৳{amount:.2f}")
            
        # --- ব্যালেন্স অ্যাড ---
        elif command == '/add_balance':
            uid = int(context.args[0])
            amt = float(context.args[1])
            u_data = await get_user_data(uid)
            
            new_bal = u_data.get('balance', 0) + amt
            new_ear = u_data.get('total_earned', 0) + amt
            
            await update_user(uid, {'balance': new_bal, 'total_earned': new_ear})
            
            await update.message.reply_text(f"✅ {uid}-এর ব্যালেন্স আপডেট। বর্তমান: ৳{new_bal:.2f}")
            try:
                await context.bot.send_message(uid, f"🎉 আপনার অ্যাকাউন্টে ৳{amt} যোগ করা হয়েছে।")
            except: pass
            
        # --- ব্যালেন্স কমানো ---
        elif command == '/reduce_balance':
            uid = int(context.args[0])
            amt = float(context.args[1])
            u_data = await get_user_data(uid)
            
            new_bal = u_data.get('balance', 0) - amt
            if new_bal < 0: new_bal = 0
            
            await update_user(uid, {'balance': new_bal})
            await update.message.reply_text(f"✅ {uid}-এর ব্যালেন্স কমানো হয়েছে। বর্তমান: ৳{new_bal:.2f}")
            try:
                await context.bot.send_message(uid, f"📢 আপনার অ্যাকাউন্ট থেকে ৳{amt} কেটে নেওয়া হয়েছে (উত্তোলন/সমন্বয়)।")
            except: pass
            
        # --- এডমিন অ্যাড ---
        elif command == '/add_admin':
            if user_id != SUPER_ADMIN_CHAT_ID:
                await update.message.reply_text("❌ শুধুমাত্র সুপার এডমিন এটি করতে পারে।")
                return
            new_admin = int(context.args[0])
            admins = GLOBAL_CONFIG.get('admin_ids', [])
            if new_admin not in admins:
                admins.append(new_admin)
                loop = asyncio.get_running_loop()
                ref = db.collection('config').document('global_settings')
                await loop.run_in_executor(None, lambda: ref.set({'admin_ids': admins}, merge=True))
                GLOBAL_CONFIG['admin_ids'] = admins
                await update.message.reply_text(f"✅ এডমিন যুক্ত করা হয়েছে: `{new_admin}`", parse_mode=ParseMode.MARKDOWN)
        
        # --- এডমিন রিমুভ ---
        elif command == '/delete_admin':
            if user_id != SUPER_ADMIN_CHAT_ID:
                await update.message.reply_text("❌ শুধুমাত্র সুপার এডমিন এটি করতে পারে।")
                return
            del_admin = int(context.args[0])
            admins = GLOBAL_CONFIG.get('admin_ids', [])
            if del_admin == SUPER_ADMIN_CHAT_ID:
                await update.message.reply_text("❌ সুপার এডমিনকে রিমুভ করা যাবে না।")
                return
            if del_admin in admins:
                admins.remove(del_admin)
                loop = asyncio.get_running_loop()
                ref = db.collection('config').document('global_settings')
                await loop.run_in_executor(None, lambda: ref.set({'admin_ids': admins}, merge=True))
                GLOBAL_CONFIG['admin_ids'] = admins
                await update.message.reply_text(f"✅ এডমিন রিমুভ করা হয়েছে: `{del_admin}`", parse_mode=ParseMode.MARKDOWN)
                
    except IndexError:
        await update.message.reply_text("❌ ভুল ফরম্যাট। কমান্ডের সাথে আইডি বা টাকার পরিমাণ দিন।")
    except Exception as e:
        await update.message.reply_text(f"❌ ত্রুটি: {e}")

