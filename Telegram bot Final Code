async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """বট শুরু করার কমান্ড।"""
    user = update.effective_user
    user_id = user.id
    
    # কনফিগ লোড নিশ্চিত করা
    if not GLOBAL_CONFIG.get('admin_ids'):
        await load_config()

    # ইউজার ডেটা চেক/তৈরি
    user_data = await get_user_data(user_id)
    
    # রেফারেল সিস্টেম (শুধুমাত্র নতুন ইউজারদের জন্য)
    if context.args and user_data.get('total_earned', 0) == 0 and user_data.get('referral_count', 0) == 0:
        try:
            ref_id_str = context.args[0].replace('ref_', '')
            ref_id = int(ref_id_str)
            if ref_id != user_id:
                bonus = GLOBAL_CONFIG.get('referral_bonus', 0.50)
                ref_data = await get_user_data(ref_id)
                
                if ref_data: # যদি রেফারকারী বৈধ হয়
                    new_bal = ref_data.get('balance', 0) + bonus
                    new_count = ref_data.get('referral_count', 0) + 1
                    new_earned = ref_data.get('total_earned', 0) + bonus
                    
                    await update_user(ref_id, {
                        'balance': new_bal,
                        'referral_count': new_count,
                        'total_earned': new_earned
                    })
                    
                    # রেফারকারীকে নোটিফিকেশন
                    try:
                        await context.bot.send_message(
                            chat_id=ref_id,
                            text=f"🎉 **নতুন রেফারেল!**\n{user.full_name} জয়েন করেছেন।\nবোনাস: ৳{bonus:.2f}\nবর্তমান ব্যালেন্স: ৳{new_bal:.2f}",
                            parse_mode=ParseMode.MARKDOWN
                        )
                    except:
                        pass
        except ValueError:
            pass

    # ইসলামিক সালাম এবং ওয়েলকাম
    await update.message.reply_text(
        f"﷽\n\nপ্রিয় {user.full_name}، **আসসালামু আলাইকুম ওয়া রাহমাতুল্লাহি ওয়া বারাকাতুহ!**\n\nআমাদের বটে আপনাকে স্বাগতম। নিচের বাটনগুলো ব্যবহার করে কাজ শুরু করুন।",
        reply_markup=REPLY_KEYBOARD,
        parse_mode=ParseMode.MARKDOWN
    )
    
    # মেইন মেনু শো করা
    await update.message.reply_text(
        MENU_DATA['main_menu']['text'],
        reply_markup=get_inline_keyboard('main_menu'),
        parse_mode=ParseMode.MARKDOWN
    )

