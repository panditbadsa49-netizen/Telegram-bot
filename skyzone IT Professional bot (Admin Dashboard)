async def post_init(app):
    await load_config()

def main():
    initialize_firestore()
    if db is False: return

    app = ApplicationBuilder().token(TOKEN).post_init(post_init).build()

    # হ্যান্ডলারস
    app.add_handler(CommandHandler("start", start))
    
    # মেনু হ্যান্ডলিং
    app.add_handler(MessageHandler(filters.Regex('^🔴 Review Generator$'), lambda u,c: u.message.reply_text("লিংক:", reply_markup=get_inline_keyboard('main_menu'))))
    app.add_handler(MessageHandler(filters.Regex('^📜 তথ্য দেখুন$'), lambda u,c: u.message.reply_text("মেনু:", reply_markup=get_inline_keyboard('info_menu'))))
    app.add_handler(MessageHandler(filters.Regex('^💼 কাজ দেখুন$'), lambda u,c: u.message.reply_text("মেনু:", reply_markup=get_inline_keyboard('work_menu'))))
    
    # ইউজার কনভারসেশন
    work_h = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^✅ কাজ জমা দিন$'), start_work)],
        states={WORK_PHOTO: [MessageHandler(filters.PHOTO, receive_work_photo)], WORK_DETAILS: [MessageHandler(filters.TEXT, receive_work_details)]},
        fallbacks=[CommandHandler('cancel', cancel)]
    )
    withdraw_h = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^💵 উত্তোলন$'), start_withdraw)],
        states={WITHDRAW_AMOUNT: [MessageHandler(filters.TEXT, receive_withdraw_amount)], WITHDRAW_METHOD: [MessageHandler(filters.TEXT, receive_withdraw_method)], WITHDRAW_NUMBER: [MessageHandler(filters.TEXT, receive_withdraw_number)]},
        fallbacks=[CommandHandler('cancel', cancel)]
    )
    
    # এডমিন কনভারসেশন
    admin_conv = ConversationHandler(
        entry_points=[CallbackQueryHandler(admin_callback_handler, pattern="^admin_")],
        states={
            ADMIN_SET_BONUS: [MessageHandler(filters.TEXT, set_bonus_state)],
            ADMIN_ADD_ADMIN: [MessageHandler(filters.TEXT, add_admin_state)],
            ADMIN_REM_ADMIN: [MessageHandler(filters.TEXT, del_admin_state)],
            ADMIN_BLOCK_USER: [MessageHandler(filters.TEXT, block_user_state)],
            ADMIN_UNBLOCK_USER: [MessageHandler(filters.TEXT, unblock_user_state)],
            ADMIN_DEL_USER: [MessageHandler(filters.TEXT, delete_user_state)],
            ADMIN_ADD_BAL: [MessageHandler(filters.TEXT, add_bal_user_state)],
        },
        fallbacks=[CommandHandler('cancel', cancel)],
        per_chat=True
    )

    app.add_handler(work_h)
    app.add_handler(withdraw_h)
    app.add_handler(admin_conv)
    
    # সাধারণ ইনলাইন হ্যান্ডলার (ইউজার)
    app.add_handler(CallbackQueryHandler(handle_menu_callback))
    
    # এডমিন কমান্ড (প্যানেল ওপেন করার জন্য)
    app.add_handler(CommandHandler("admin", admin_panel_command))
    
    # সাধারণ মেসেজ ফরওয়ার্ডিং
    async def forward_msg(update, context):
        if update.message.chat_id != SUPER_ADMIN_CHAT_ID:
            await update.message.forward(SUPER_ADMIN_CHAT_ID)
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, forward_msg))

    print("✅ বট চালু হয়েছে...")
    app.run_polling()

if __name__ == "__main__":
    main()
