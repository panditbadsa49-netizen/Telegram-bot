async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    
    # কনফিগারেশন লোড করা নিশ্চিত করা
    if not GLOBAL_CONFIG.get('admin_ids') or len(GLOBAL_CONFIG['admin_ids']) <= 1: # ১ বা তার কম হলে লোড করা
        await load_config()

    user_data = await get_user_data(user.id)
    
    # ব্লক চেক
    if user_data and user_data.get('is_blocked', False):
        await update.message.reply_text("⛔ আপনাকে এই বট ব্যবহার করা থেকে ব্লক করা হয়েছে। এডমিনের সাথে যোগাযোগ করুন।")
        return

    # রেফারেল সিস্টেম (শুধুমাত্র নতুন ইউজারের জন্য)
    if context.args and user_data.get('total_earned', 0) == 0 and user_data.get('referral_count', 0) == 0:
        try:
            # ref_ID এক্সট্রাক্ট করা
            ref_id_str = context.args[0].split('_')[-1]
            ref_id = int(ref_id_str)
            
            if ref_id != user.id:
                bonus = GLOBAL_CONFIG.get('referral_bonus', 0.50)
                ref_data = await get_user_data(ref_id)
                if ref_data:
                    # রেফারকারীর ব্যালেন্স বৃদ্ধি 
                    new_bal = ref_data.get('balance', 0) + bonus
                    new_count = ref_data.get('referral_count', 0) + 1
                    new_earned = ref_data.get('total_earned', 0) + bonus
                    await update_user(ref_id, {'balance': new_bal, 'referral_count': new_count, 'total_earned': new_earned})
                    try:
                        await context.bot.send_message(chat_id=ref_id, text=f"🎉 নতুন রেফারেল! আপনার অ্যাকাউন্টে **৳{bonus:.2f}** যোগ হয়েছে।", parse_mode=ParseMode.MARKDOWN)
                    except: pass
        except ValueError: 
            logger.warning(f"Invalid referral ID format: {context.args[0]}")
        except Exception as e:
            logger.error(f"Referral processing error: {e}")

    # মেইন মেনু ডিসপ্লে
    await update.message.reply_text(
        f"﷽\n\nপ্রিয় {user.full_name}। আমাদের বটে স্বাগতম।",
        reply_markup=REPLY_KEYBOARD,
        parse_mode=ParseMode.MARKDOWN
    )
    # ইনলাইন কীবোর্ড সহ মেইন মেনু
    await update.message.reply_text(
        MENU_DATA['main_menu']['text'],
        reply_markup=get_inline_keyboard('main_menu'),
        parse_mode=ParseMode.MARKDOWN
    )

async def handle_menu_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """ইউজারদের মেনু বাটন হ্যান্ডলিং (ক্লিন UI-এর জন্য edit_message_text)।"""
    query = update.callback_query
    await query.answer()
    data = query.data
    
    if data.startswith("admin_"): return # এডমিন কলব্যাক এখানে হ্যান্ডল হবে না

    # মূল মেনু পরিবর্তন
    if data in MENU_DATA:
        try:
            await query.edit_message_text(
                MENU_DATA[data]['text'],
                reply_markup=get_inline_keyboard(data),
                parse_mode=ParseMode.MARKDOWN
            )
        except: 
            # যদি মেসেজ এডিট না করা যায় (যেমন খুব দ্রুত ক্লিক করলে), তবে নতুন মেসেজ পাঠানো যেতে পারে।
            pass 
        
    elif data == 'check_balance':
        data = await get_user_data(query.from_user.id)
        msg = f"💰 **ওয়ালেট**\nটাকা: ৳{data.get('balance', 0):.2f}\nরেফার: {data.get('referral_count', 0)} জন\nমোট আয়: ৳{data.get('total_earned', 0):.2f}"
        try:
            await query.edit_message_text(msg, parse_mode=ParseMode.MARKDOWN, reply_markup=get_inline_keyboard('info_menu'))
        except: pass
        
    elif data == 'get_referral_link':
        bonus = GLOBAL_CONFIG.get('referral_bonus', 0.50)
        # সঠিক রেফারেল লিংক তৈরি 
        link = f"https://t.me/{context.bot.username}?start=ref_{query.from_user.id}"
        msg = f"🔗 **আপনার রেফারেল লিংক**\n`{link}`\n\nপ্রতি রেফার: ৳{bonus:.2f}"
        try:
            await query.edit_message_text(msg, parse_mode=ParseMode.MARKDOWN, reply_markup=get_inline_keyboard('work_menu'))
        except: pass

