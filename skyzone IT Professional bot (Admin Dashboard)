async def admin_callback_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """এডমিন প্যানেলের বাটন হ্যান্ডলিং (ক্লিন UI এর জন্য সম্পাদনা)।"""
    query = update.callback_query
    await query.answer()
    data = query.data
    
    if not is_admin(query.from_user.id): return

    # --- মেনু ক্লোজ বা ব্যাক হ্যান্ডলিং ---
    if data == "admin_close":
        await query.message.delete()
        return ConversationHandler.END # যদি কোনো চলমান কনভারসেশন থাকে তা বন্ধ হবে
        
    elif data == "admin_back_main":
        try:
            await query.edit_message_text("🎛 **এডমিন ড্যাশবোর্ড**\nআপনার অপশন নির্বাচন করুন:", reply_markup=ADMIN_DASHBOARD_KB, parse_mode=ParseMode.MARKDOWN)
        except: pass
        return ConversationHandler.END

    # --- সাবমেনু ওপেন করা ---
    elif data == "admin_manage_admin_menu":
        await query.edit_message_text("👮 **এডমিন ম্যানেজমেন্ট**\nকি করতে চান?", reply_markup=ADMIN_MANAGE_ADMIN_KB, parse_mode=ParseMode.MARKDOWN)
        
    elif data == "admin_manage_user_menu":
        await query.edit_message_text("👤 **ইউজার ম্যানেজমেন্ট**\nঅপশন সিলেক্ট করুন:", reply_markup=ADMIN_MANAGE_USER_KB, parse_mode=ParseMode.MARKDOWN)

    # --- পরিসংখ্যান ---
    elif data == "admin_stats":
        # মোট ইউজার কাউন্ট করা 
        if db:
            loop = asyncio.get_running_loop()
            users_ref = db.collection('users')
            # এটি একটি ধীর প্রক্রিয়া হতে পারে, কিন্তু সহজ কাউন্টিংয়ের জন্য ঠিক আছে
            docs = await loop.run_in_executor(None, users_ref.stream) 
            count = sum(1 for _ in docs)
        else:
            count = "N/A (DB not connected)"
        
        txt = f"📊 **পরিসংখ্যান**\n\n👥 মোট ইউজার: **{count}** জন\n💰 বর্তমান রেফার বোনাস: **৳{GLOBAL_CONFIG.get('referral_bonus', 0.50):.2f}**"
        
        # পূর্বের মেনু সম্পাদনা করে নতুন পরিসংখ্যান দেখানো
        await query.edit_message_text(txt, reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 ব্যাক", callback_data="admin_back_main")]]), parse_mode=ParseMode.MARKDOWN)

    # --- এডমিন লিস্ট ---
    elif data == "admin_show_list":
        admins = GLOBAL_CONFIG.get('admin_ids', [])
        txt = "📋 **বর্তমান এডমিন লিস্ট:**\n" + "\n".join([f"`{aid}`" for aid in admins])
        await query.edit_message_text(txt, reply_markup=ADMIN_MANAGE_ADMIN_KB, parse_mode=ParseMode.MARKDOWN)

    # --- ইনপুট মোড শুরু (Conversation Entry Points) ---
    # এখানে মেনু মেসেজটি এডিট না করে একটি নতুন মেসেজ পাঠানো হয় ও রিপ্লাই কীবোর্ড রিমুভ করা হয়।
    
    elif data == "admin_set_bonus":
        await query.message.reply_text("🎁 **রেফারেল বোনাস সেট**\nনতুন বোনাস এমাউন্ট লিখুন (যেমন: `1.50`) বা `/cancel` করুন:", reply_markup=ReplyKeyboardRemove(), parse_mode=ParseMode.MARKDOWN)
        return ADMIN_SET_BONUS
    
    elif data == "admin_add_new":
        await query.message.reply_text("➕ **এডমিন যুক্ত করুন**\nনতুন এডমিনের Telegram ID লিখুন বা `/cancel` করুন:", reply_markup=ReplyKeyboardRemove())
        return ADMIN_ADD_ADMIN
        
    elif data == "admin_remove_exist":
        await query.message.reply_text("➖ **এডমিন রিমুভ করুন**\nযাকে রিমুভ করতে চান তার ID লিখুন বা `/cancel` করুন:", reply_markup=ReplyKeyboardRemove())
        return ADMIN_REM_ADMIN
        
    elif data == "admin_block_u":
        await query.message.reply_text("🚫 **ইউজার ব্লক**\nযাকে ব্লক করবেন তার ID লিখুন বা `/cancel` করুন:", reply_markup=ReplyKeyboardRemove())
        return ADMIN_BLOCK_USER
        
    elif data == "admin_unblock_u":
        await query.message.reply_text("✅ **ইউজার আনব্লক**\nযাকে আনব্লক করবেন তার ID লিখুন বা `/cancel` করুন:", reply_markup=ReplyKeyboardRemove())
        return ADMIN_UNBLOCK_USER
        
    elif data == "admin_delete_u":
        await query.message.reply_text("🗑 **ইউজার ডিলিট**\nযাকে ডিলিট করবেন তার ID লিখুন (সতর্কতা: সব ডেটা মুছে যাবে!) বা `/cancel` করুন:", reply_markup=ReplyKeyboardRemove())
        return ADMIN_DEL_USER
        
    elif data == "admin_add_bal_u":
        await query.message.reply_text("💳 **ম্যানুয়াল ব্যালেন্স অ্যাড**\nফরম্যাট: `ID Amount`\nউদাহরণ: `1234567890 50.50` বা `/cancel` করুন।", parse_mode=ParseMode.MARKDOWN, reply_markup=ReplyKeyboardRemove())
        return ADMIN_ADD_BAL

    return ConversationHandler.END # অন্যান্য কলব্যাক হ্যান্ডলার শেষ

