# === ৮. মেইন রানার ও হ্যান্ডলার সংযোগ ===
# =================================================================

async def post_init(app):
    """বট শুরু হওয়ার পর কনফিগারেশন লোড করা।"""
    await load_config()
    logger.info("Bot configuration loaded and running.")

def main():
    initialize_firestore()
    
    # টোকেন লোড হয়েছে কিনা নিশ্চিত করা
    if not TOKEN:
        logger.critical("❌ FATAL: বট টোকেন এনভায়রনমেন্ট ভেরিয়েবল (TELEGRAM_BOT_TOKEN) থেকে লোড হতে পারেনি। বট চালু হচ্ছে না।")
        return

    app = ApplicationBuilder().token(TOKEN).post_init(post_init).build()

    # --- ১. ইউজার কনভারসেশন হ্যান্ডলার্স ---
    work_h = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^✅ কাজ জমা দিন$'), start_work)],
        states={
            WORK_PHOTO: [MessageHandler(filters.PHOTO, receive_work_photo)], 
            WORK_DETAILS: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_work_details)]
        },
        fallbacks=[CommandHandler('cancel', cancel)],
        per_user=True
    )
    withdraw_h = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex('^💵 উত্তোলন$'), start_withdraw)],
        states={
            WITHDRAW_AMOUNT: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_withdraw_amount)], 
            WITHDRAW_METHOD: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_withdraw_method)], 
            WITHDRAW_NUMBER: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_withdraw_number)]
        },
        fallbacks=[CommandHandler('cancel', cancel)],
        per_user=True
    )
    
    # --- ২. এডমিন কনভারসেশন হ্যান্ডলার্স (বাটন থেকে ইনপুট) ---
    admin_conv = ConversationHandler(
        # এন্ট্রি পয়েন্ট: যখন এডমিন প্যানেল থেকে কোনো ইনপুট-ভিত্তিক বাটনে ক্লিক করা হয়
        entry_points=[CallbackQueryHandler(admin_callback_handler, pattern="^admin_")],
        states={
            ADMIN_SET_BONUS: [MessageHandler(filters.TEXT & ~filters.COMMAND, set_bonus_state)],
            ADMIN_ADD_ADMIN: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_admin_state)],
            ADMIN_REM_ADMIN: [MessageHandler(filters.TEXT & ~filters.COMMAND, del_admin_state)],
            ADMIN_BLOCK_USER: [MessageHandler(filters.TEXT & ~filters.COMMAND, block_user_state)],
            ADMIN_UNBLOCK_USER: [MessageHandler(filters.TEXT & ~filters.COMMAND, unblock_user_state)],
            ADMIN_DEL_USER: [MessageHandler(filters.TEXT & ~filters.COMMAND, delete_user_state)],
            ADMIN_ADD_BAL: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_bal_user_state)],
        },
        fallbacks=[CommandHandler('cancel', cancel)],
        per_user=True # এডমিন প্যানেলের ইনপুট কনভারসেশন ইউজার-ভিত্তিক
    )

    # --- ৩. মেইন কমান্ড ও মেনু হ্যান্ডলার্স ---
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("admin", admin_panel_command)) # এডমিন প্যানেল ওপেন

    # রিপ্লাই কীবোর্ড বাটনের প্রাথমিক হ্যান্ডলিং
    app.add_handler(MessageHandler(filters.Regex('^🔴 Review Generator$'), lambda u,c: u.message.reply_text("লিংক নিচে:", reply_markup=get_inline_keyboard('main_menu'))))
    app.add_handler(MessageHandler(filters.Regex('^📜 তথ্য দেখুন$'), lambda u,c: u.message.reply_text("মেনু নিচে:", reply_markup=get_inline_keyboard('info_menu'))))
    app.add_handler(MessageHandler(filters.Regex('^💼 কাজ দেখুন$'), lambda u,c: u.message.reply_text("মেনু নিচে:", reply_markup=get_inline_keyboard('work_menu'))))
    
    # ইউজার ইনলাইন মেনু (Callback) হ্যান্ডলার
    app.add_handler(CallbackQueryHandler(handle_menu_callback, pattern="^(?!admin_)"))
    
    # কনভারসেশন হ্যান্ডলার যোগ করা
    app.add_handler(work_h)
    app.add_handler(withdraw_h)
    app.add_handler(admin_conv)
    
    logger.info("✅ প্রোফেশনাল বট চালু হচ্ছে...")
    app.run_polling()

if __name__ == "__main__":
    main()
