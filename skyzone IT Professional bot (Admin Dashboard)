def get_inline_keyboard(menu_key):
    """ইউজারদের জন্য ইনলাইন কীবোর্ড তৈরি করে।"""
    menu = MENU_DATA.get(menu_key)
    if not menu: return None
    keyboard = []
    for row in menu['buttons']:
        new_row = []
        for btn in row:
            if 'url' in btn:
                new_row.append(InlineKeyboardButton(btn['text'], url=btn['url']))
            elif 'data' in btn:
                new_row.append(InlineKeyboardButton(btn['text'], callback_data=btn['data']))
        keyboard.append(new_row)
    return InlineKeyboardMarkup(keyboard)


