        loop = asyncio.get_running_loop()
        users_ref = db.collection('users')
        # এটি একটি সহজ কাউন্ট (বড় ডেটাবেসে অ্যাগ্রিগেশন কুয়েরি ভালো)
        docs = await loop.run_in_executor(None, users_ref.stream)
