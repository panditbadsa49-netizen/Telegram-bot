def is_admin(user_id):
    if user_id == SUPER_ADMIN_CHAT_ID: return True
    return user_id in GLOBAL_CONFIG.get('admin_ids', [])

async def get_user_data(user_id):
    if not db: return None
    loop = asyncio.get_running_loop()
    doc_ref = db.collection('users').document(str(user_id))
    doc = await loop.run_in_executor(None, doc_ref.get)
    
    if doc.exists:
        return doc.to_dict()
    else:
        new_data = {
            'balance': 0.00,
            'total_earned': 0.00,
            'referral_count': 0,
            'joined_at': time.time(),
            'is_blocked': False 
        }
        await loop.run_in_executor(None, lambda: doc_ref.set(new_data))
        return new_data

async def update_user(user_id, data, merge=True):
    if not db: return
    loop = asyncio.get_running_loop()
    doc_ref = db.collection('users').document(str(user_id))
    await loop.run_in_executor(None, lambda: doc_ref.set(data, merge=merge))

