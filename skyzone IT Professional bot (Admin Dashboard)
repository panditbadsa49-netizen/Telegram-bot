def initialize_firestore():
    """Firestore কানেকশন তৈরি করে।"""
    global db
    if db is None:
        try:
            # JSON স্ট্রিং লোড করা হচ্ছে 
            cred_dict = json.loads(FIREBASE_CREDENTIALS_JSON)
            
            # ডামি ক্রেডেনশিয়াল চেক: যদি 'PROJECT_ID' বা 'KEY_ID' ডিফল্ট থাকে তবে সংযোগ করা হবে না।
            is_placeholder = ('project_id' in cred_dict and cred_dict['project_id'] == 'PROJECT_ID')
            
            if cred_dict and not is_placeholder:
                cred = credentials.Certificate(cred_dict)
                if not firebase_admin._apps:
                    firebase_admin.initialize_app(cred)
                db = firestore.client()
                logger.info("✅ Firestore সফলভাবে সংযুক্ত হয়েছে।")
            else:
                logger.error("❌ ত্রুটি: JSON ক্রেডেনশিয়াল লোড করা হয়নি বা এটি ডিফল্ট প্লেসহোল্ডার। বট ডাটাবেস ছাড়া চলছে।")
                # ডামি ডিবি সেট করা হয়েছে
                db = False
        except json.JSONDecodeError:
            logger.error("❌ ত্রুটি: FIREBASE_CREDENTIALS_JSON ভেরিয়েবলটি সঠিক JSON ফরম্যাটে নেই।")
            db = False
        except Exception as e:
            logger.error(f"❌ Firestore সংযোগে গুরুতর ত্রুটি: {e}")
            db = False 

async def load_config():
    """ডাটাবেস থেকে কনফিগারেশন লোড করে।"""
    global GLOBAL_CONFIG
    # DB কানেক্ট না থাকলে লোড করা যাবে না
    if db:
        try:
            loop = asyncio.get_running_loop()
            doc_ref = db.collection('config').document('global_settings')
            # Firestore অপারেশন এক্সিকিউটর-এ রান করানো হলো
            doc = await loop.run_in_executor(None, doc_ref.get)
            
            if doc.exists:
                data = doc.to_dict()
                # ডেটা টাইপ নিশ্চিত করা
                GLOBAL_CONFIG['referral_bonus'] = float(data.get('referral_bonus', 0.50))
                
                # এডমিন লিস্টে সুপার এডমিন সর্বদা থাকবে
                saved_admins = data.get('admin_ids', [])
                if SUPER_ADMIN_CHAT_ID not in saved_admins:
                    # নিশ্চিত করা যে SUPER_ADMIN_CHAT_ID একটি বৈধ ID (0 না)
                    if SUPER_ADMIN_CHAT_ID != 0:
                         saved_admins.append(SUPER_ADMIN_CHAT_ID)
                         await loop.run_in_executor(None, lambda: doc_ref.set({'admin_ids': saved_admins}, merge=True))
                         
                GLOBAL_CONFIG['admin_ids'] = saved_admins
            else:
                # প্রথমবার চললে প্রাথমিক কনফিগারেশন সেভ করা 
                initial_config = {'referral_bonus': 0.50, 'admin_ids': [SUPER_ADMIN_CHAT_ID]}
                if SUPER_ADMIN_CHAT_ID != 0:
                    await loop.run_in_executor(None, lambda: doc_ref.set(initial_config))
                GLOBAL_CONFIG = initial_config
        except Exception as e:
            logger.error(f"⚠️ কনফিগারেশন লোড ব্যর্থ: {e}")

