async def add_bal_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """ম্যানুয়ালি ইউজার ব্যালেন্স যোগ করে।"""
    try:
        parts = update.message.text.split()
        if len(parts) != 2: raise ValueError("Invalid format")
        
        uid = int(parts[0])
        amt = float(parts[1])
        
        ud = await get_user_data(uid)
        new_bal = ud.get('balance', 0.00) + amt
        new_earned = ud.get('total_earned', 0.00) + amt # Total earned এও যোগ করা
        
        await update_user(uid, {'balance': new_bal, 'total_earned': new_earned})
        
        await update.message.reply_text(f"💳 সফলভাবে ৳{amt:.2f} যোগ করা হয়েছে। ইউজার `{uid}` এর বর্তমান ব্যালেন্স: ৳{new_bal:.2f}", reply_markup=REPLY_KEYBOARD, parse_mode=ParseMode.MARKDOWN)
        try: await context.bot.send_message(uid, f"🎉 আপনার অ্যাকাউন্টে এডমিন দ্বারা **৳{amt:.2f}** যোগ হয়েছে।")
        except: pass
    except: 
        await update.message.reply_text("❌ ভুল ফরম্যাট। সঠিক ফরম্যাট: `ID Amount` (যেমন: `1234567890 50.50`)", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END


