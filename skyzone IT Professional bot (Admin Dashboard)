# --- এডমিন ইনপুট হ্যান্ডলারস ---

async def set_bonus_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        amount = float(update.message.text)
        loop = asyncio.get_running_loop()
        ref = db.collection('config').document('global_settings')
        await loop.run_in_executor(None, lambda: ref.set({'referral_bonus': amount}, merge=True))
        GLOBAL_CONFIG['referral_bonus'] = amount
        await update.message.reply_text(f"✅ বোনাস সেট: ৳{amount}", reply_markup=REPLY_KEYBOARD)
    except: await update.message.reply_text("❌ ভুল ইনপুট।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

async def add_admin_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        aid = int(update.message.text)
        admins = GLOBAL_CONFIG.get('admin_ids', [])
        if aid not in admins:
            admins.append(aid)
            loop = asyncio.get_running_loop()
            ref = db.collection('config').document('global_settings')
            await loop.run_in_executor(None, lambda: ref.set({'admin_ids': admins}, merge=True))
            GLOBAL_CONFIG['admin_ids'] = admins
            await update.message.reply_text(f"✅ এডমিন যুক্ত: {aid}", reply_markup=REPLY_KEYBOARD)
        else: await update.message.reply_text("⚠️ ইতিমধ্যে এডমিন।", reply_markup=REPLY_KEYBOARD)
    except: await update.message.reply_text("❌ ভুল ID।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

async def del_admin_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        aid = int(update.message.text)
        if aid == SUPER_ADMIN_CHAT_ID:
            await update.message.reply_text("❌ সুপার এডমিন রিমুভ করা যাবে না।", reply_markup=REPLY_KEYBOARD)
            return ConversationHandler.END
        admins = GLOBAL_CONFIG.get('admin_ids', [])
        if aid in admins:
            admins.remove(aid)
            loop = asyncio.get_running_loop()
            ref = db.collection('config').document('global_settings')
            await loop.run_in_executor(None, lambda: ref.set({'admin_ids': admins}, merge=True))
            GLOBAL_CONFIG['admin_ids'] = admins
            await update.message.reply_text(f"✅ এডমিন রিমুভড: {aid}", reply_markup=REPLY_KEYBOARD)
    except: await update.message.reply_text("❌ ভুল।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

async def block_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        uid = int(update.message.text)
        await update_user(uid, {'is_blocked': True})
        await update.message.reply_text(f"🚫 ইউজার {uid} ব্লকড।", reply_markup=REPLY_KEYBOARD)
    except: await update.message.reply_text("❌ ভুল।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

async def unblock_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        uid = int(update.message.text)
        await update_user(uid, {'is_blocked': False})
        await update.message.reply_text(f"✅ ইউজার {uid} আনব্লকড।", reply_markup=REPLY_KEYBOARD)
    except: await update.message.reply_text("❌ ভুল।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

async def delete_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        uid = int(update.message.text)
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(None, lambda: db.collection('users').document(str(uid)).delete())
        await update.message.reply_text(f"🗑 ইউজার {uid} ডিলিটেড।", reply_markup=REPLY_KEYBOARD)
    except: await update.message.reply_text("❌ ভুল।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

async def add_bal_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        parts = update.message.text.split()
        uid = int(parts[0])
        amt = float(parts[1])
        ud = await get_user_data(uid)
        new_bal = ud.get('balance', 0) + amt
        await update_user(uid, {'balance': new_bal})
        await update.message.reply_text(f"💳 ব্যালেন্স অ্যাড। বর্তমান: ৳{new_bal}", reply_markup=REPLY_KEYBOARD)
        try: await context.bot.send_message(uid, f"🎉 অ্যাকাউন্টে ৳{amt} যোগ হয়েছে।")
        except: pass
    except: await update.message.reply_text("❌ ভুল ফরম্যাট।", reply_markup=REPLY_KEYBOARD)
    return ConversationHandler.END

