    if data == "admin_close":
        await query.message.delete()
        
    elif data == "admin_back_main":
        await query.edit_message_text("🎛 **এডমিন ড্যাশবোর্ড**", reply_markup=ADMIN_DASHBOARD_KB, parse_mode=ParseMode.MARKDOWN)
        
